# Vite environment variables (used by client/src/api.js)
# https://vite.dev/guide/env-and-mode.html
#
# REQUIRED for production/staging builds. The build fails when this is missing.
# Local development falls back to http://localhost:3000 when this is unset.
# Placeholder only -- do not commit a real staging URL or any secret here.
VITE_API_URL=https://your-staging-backend.example.com

# Firebase web config for Authentication. These are public client identifiers,
# not server secrets. The client does not initialize Firestore or Firebase
# Storage: application data goes through the API and uploads use Cloudinary.
# Use the config for the Firebase project the staging backend uses.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
# BookMe server -- environment template.
#
# Copy this file to `.env` in this directory and fill in real values:
#
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows (cmd)
#
# `.env` is gitignored and MUST NOT be committed. This template contains NO
# secrets and NO real values -- every entry below is a placeholder.
#
# The server loads `.env` through `require('dotenv').config()` at the top of
# `app.js`. `dotenv` does not override variables already present in the real
# environment, so a platform (Heroku, Render, a container) can set these itself
# and the file is then unnecessary.


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Port the server listens on. Read by `bin/www` at startup. Optional; when it is
# absent the server falls back to Express's default (3000 in development).
PORT=3000

# Reverse proxy trust. Optional; default false. Set this to the EXACT number of
# reverse proxies in front of the app only when the app is not directly
# reachable. For one trusted proxy, use 1. Do NOT use `true`.
# TRUST_PROXY=1

# Maximum accepted JSON and form body sizes. Optional; defaults are 1mb and
# 100kb. Larger request bodies are refused with 413 before any route runs.
# REQUEST_BODY_LIMIT=1mb
# URLENCODED_BODY_LIMIT=100kb

# HTTP server timeouts in milliseconds. Optional; defaults are 30000 for the
# whole request, 15000 for headers, and 5000 for keep-alive. Headers must time
# out before the whole request, and keep-alive before headers.
# REQUEST_TIMEOUT_MS=30000
# HEADERS_TIMEOUT_MS=15000
# KEEP_ALIVE_TIMEOUT_MS=5000

# Rate limiting. Optional; the defaults below apply when NODE_ENV=production.
# They are intentionally more permissive outside production. The in-memory
# store is per process, so a multi-instance deployment needs a shared store.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
# PAYMENT_RATE_LIMIT_MAX=30
# RELEASE_RATE_LIMIT_MAX=20
# UPLOAD_RATE_LIMIT_MAX=30
# WEBHOOK_RATE_LIMIT_MAX=120


# ---------------------------------------------------------------------------
# Staging/production environment
# ---------------------------------------------------------------------------
# REQUIRED for staging/production. `production` switches Express to redacted
# JSON error responses and requires an explicit CORS allowlist. Local
# development should leave this unset or use `development`.
NODE_ENV=production

# REQUIRED in production. Comma-separated exact browser origins allowed to call
# this API. No wildcards, suffix matching or arbitrary reflection. When empty in
# production, all browser origins are refused; non-browser requests with no
# Origin header still work.
CORS_ORIGINS=https://your-staging-frontend.example.com


# ---------------------------------------------------------------------------
# Firebase  --  service-account credential
# ---------------------------------------------------------------------------
# Firebase credentials are NOT individual environment variables. The server
# reads a service-account JSON file and calls `admin.initializeApp()` at load
# time. By default it looks in `server/config/` for the project's credential.
# The file is gitignored and is DEPLOYMENT-SPECIFIC: place it on the host
# out-of-band (a secret mount, a build step, a config tool). The server will not
# start without a usable credential.
#
# FIREBASE_SERVICE_ACCOUNT_PATH is OPTIONAL. Set it only when the deployment
# mounts the JSON somewhere other than the default path; otherwise omit it.
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/mounted/service-account.json


# ---------------------------------------------------------------------------
# Cloudinary  --  signed uploads and private asset access
# ---------------------------------------------------------------------------
# All three are required for file uploads (profile photos, resumes, task
# submissions). When any is blank the upload-signing endpoints answer 503 and
# everything else keeps working -- see `server/config/cloudinary.js`. The secret
# never leaves the server.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional isolation namespace for every upload folder. Leave blank to preserve
# the historical folders (`profilePics/...`, `resumes/...`,
# `taskSubmissions/...`). Set a distinct value per deployment when staging and
# production share one Cloudinary account. Recommended staging value:
# CLOUDINARY_FOLDER_PREFIX=kachploy/staging
#
# The value is a slash-separated path of letters, numbers, dots, underscores and
# hyphens. It is prepended to signing, ownership checks and deletion paths.
CLOUDINARY_FOLDER_PREFIX=


# ---------------------------------------------------------------------------
# Paystack  --  TEST MODE REQUIRED FOR STAGING
# ---------------------------------------------------------------------------
# REQUIRED for staging: PAYSTACK_MODE=test and an sk_test_ secret key.
#
# `PAYSTACK_MODE` selects the provider environment explicitly:
#   unset / blank  -> test  (safe default; existing deployments are unchanged)
#   test           -> Test Mode, `PAYSTACK_SECRET_KEY` must start with `sk_test_`
#   live           -> Live Mode, `PAYSTACK_SECRET_KEY` must start with `sk_live_`
# Any other value is a configuration error (503), never a fallback. The key's
# prefix must match the selected mode; a mismatch is refused at request time.
#
# `PAYSTACK_SECRET_KEY` is the only secret the server uses. It is never logged,
# returned or serialized.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key

# REQUIRED for staging: keep live payouts explicitly disabled. This is a
# SEPARATE opt-in from PAYSTACK_MODE; even with PAYSTACK_MODE=live, transfers
# stay blocked unless this is exactly `true`. Missing, blank, or any other value
# is treated as false.
PAYSTACK_LIVE_PAYOUTS_ENABLED=false

# `PAYSTACK_PUBLIC_KEY` is present in some existing `.env` files but is NOT read
# by this server -- Paystack checkout is driven from the authorization URL the
# initialize call returns, not from a client-side public key. Listed here only
# for completeness; safe to omit.
# PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_test_public_key


# ---------------------------------------------------------------------------
# Release reconciliation  --  operational investigation only
# ---------------------------------------------------------------------------
# A release/attempt older than this threshold is considered STALE FOR
# INVESTIGATION, never proof of failure. The value is milliseconds. Optional;
# the default is 15 minutes. Reconciliation never submits a payout and never
# writes a ledger entry.
# RELEASE_RECONCILIATION_STALE_AFTER_MS=900000
#
# Maximum records a reconciliation worker examines in one bounded batch.
# Optional; default 25, hard maximum 100.
# RELEASE_RECONCILIATION_BATCH_SIZE=25

